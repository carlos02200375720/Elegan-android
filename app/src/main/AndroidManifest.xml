<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".EleganApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication"
        android:usesCleartextTraffic="false">
        <meta-data
            android:name="io.sentry.auto-init"
            android:value="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <!-- Inicialización automática mínima y sin I/O en el arranque en frío -->
            <meta-data
                android:name="com.example.startup.ClienteHttpInitializer"
                android:value="androidx.startup" />
            <!-- Desactiva el autodescubrimiento temprano de WorkManager para usar inicialización bajo demanda
                 (Configuration.Provider en EleganApplication) y programación diferida tras el primer frame -->
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
            <!-- SentryInitializer, BaseDatosLocalInitializer y SincronizacionCatalogoInitializer se inicializan
                 de forma diferida tras el primer frame mediante AppInitializer.initializeComponent(...) -->
        </provider>

        <receiver
            android:name=".ui.ReceptorCompartidoPublicacion"
            android:exported="false" />
    </application>

</manifest>
